# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: run the auth E2E suite against an already deployed preview.
# Leave empty for the local production server started by Playwright.
E2E_EXTERNAL_BASE_URL=

# Production setup database connection (session-pooler URL). TEST_DATABASE_URL
# is used by the no-Docker integration harness and is also accepted by setup.
DATABASE_URL=

# Supabase (new-style keys — legacy anon/service_role are deprecated)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Database tests + migrations (ADR 0003: no Docker — cloud project,
# session pooler string; also set as TEST_DATABASE_URL in GitHub secrets)
TEST_DATABASE_URL=
# Exact Supabase project ref; required by the destructive test-db reset script.
BOARDSTARTER_DB_RESET_CONFIRM=

# Lemon Squeezy
PAYMENT_PROVIDER=lemonsqueezy # use fake only for deterministic local/E2E runs
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Email
EMAIL_PROVIDER=resend # smtp for Mailpit, fake for integration tests
RESEND_API_KEY=
EMAIL_FROM="Jobs <jobs@yourdomain.com>"
ALERT_TOKEN_SECRET=
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# Ops
CRON_SECRET=
RATE_LIMIT_SECRET=
ADMIN_EMAIL=

# Optional
GROQ_API_KEY=
GOOGLE_INDEXING_SA_JSON=
NEXT_PUBLIC_PRESET=remote

# Auth
# Set to true only after enabling the Google provider in the Supabase
# dashboard. Also add <site-url>/callback to the redirect allow-list there.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
