{
  "name": "boardstarter",
  "version": "0.1.0",
  "description": "Open-source self-hosted niche job board",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:forbidden": "tsx scripts/check-forbidden.ts",
    "check-env": "tsx scripts/check-env.ts",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:payments": "vitest run --project unit tests/unit/payments-contract.spec.ts tests/unit/payments-lemonsqueezy.spec.ts tests/unit/payments-processor.spec.ts tests/unit/payments-provider.spec.ts tests/unit/payments-route.spec.ts tests/unit/payments-signature.spec.ts --coverage --coverage.include=src/lib/payments/**",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "test:auth": "playwright test --workers=1 e2e/auth e2e/employer/account-settings.spec.ts",
    "test:smoke": "playwright test --grep @smoke",
    "verify:security": "tsx scripts/verify-security.ts",
    "setup": "tsx scripts/setup.ts",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "gen:types": "tsx scripts/gen-types.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:db": "tsx scripts/test-db.ts",
    "test:data": "vitest run --project integration --coverage --coverage.include=src/lib/data/**"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.11.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
